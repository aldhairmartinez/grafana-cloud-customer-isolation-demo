    {
      "id": 9,
      "type": "timeseries",
      "title": "JVM heap used vs max",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "__DS_PROM_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
