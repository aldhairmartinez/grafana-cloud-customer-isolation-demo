          "expr": "sum by (customer_name) (rate(publishing_http_requests_total{demo=\"customer-isolation\", service_name=\"publishing-api\", customer_id=~\"$customer\", status=~\"5..\"}[$__rate_interval])) / sum by (customer_name) (rate(publishing_http_requests_total{demo=\"customer-isolation\", service_name=\"publishing-api\", customer_id=~\"$customer\"}[$__rate_interval]))",
          "legendFormat": "{{customer_name}}"
