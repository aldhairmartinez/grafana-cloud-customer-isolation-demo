    {
      "id": 10,
      "type": "timeseries",
      "title": "Log volume by level",
      "datasource": {
        "type": "loki",
        "uid": "__DS_LOGS_UID__"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "__DS_LOGS_UID__"
          },
          "expr": "sum by (customer_name, detected_level) (count_over_time({demo=\"customer-isolation\", service_name=\"publishing-api\", customer_id=~\"$customer\"}[$__auto]))",
          "legendFormat": "{{customer_name}} {{detected_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 70
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Application logs",
      "datasource": {
        "type": "loki",
        "uid": "__DS_LOGS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "__DS_LOGS_UID__"
          },
          "expr": "{demo=\"customer-isolation\", service_name=\"publishing-api\", customer_id=~\"$customer\"} | json | level=~\"$level\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "prettifyLogMessage": false
      }
