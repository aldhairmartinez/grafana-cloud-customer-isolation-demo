# Copy to .env (git-ignored), then: chmod 600 .env
# Never commit .env. Never paste token values into issues, chats or logs.

# ---------------------------------------------------------------------------
# Demo naming (optional; these are the defaults)
# ---------------------------------------------------------------------------
# Comma-separated id:Display Name pairs. The first customer gets the "healthy"
# profile, the second the "recurring incident" profile, and so on alternately.
CUSTOMERS="customer-a:Customer A,customer-b:Customer B"
TEAM_PREFIX="Isolation Demo"                # teams: "<prefix> - Customer A", "<prefix> - Operators"
OPERATOR_RULE='{ demo="customer-isolation" }'
FOLDER_UID=customer-isolation-demo
FOLDER_TITLE="Customer Isolation Demo"
DASHBOARD_UID=customer-isolation
DS_PROM_UID=customer-isolation-lbac-prom
DS_LOGS_UID=customer-isolation-lbac-logs

# ---------------------------------------------------------------------------
# Ingestion (used by Alloy, via start.sh)
# From your stack's details page in the Cloud Portal (Prometheus / Loki "Details").
# ---------------------------------------------------------------------------
GC_METRICS_PUSH_URL="https://<prometheus-host>.grafana.net/api/prom/push"
GC_METRICS_USER="<metrics-instance-id>"
GC_LOGS_PUSH_URL="https://<logs-host>.grafana.net/loki/api/v1/push"
GC_LOGS_USER="<logs-instance-id>"
# Cloud Access Policy token, scopes: metrics:write, logs:write
GC_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Query side (used by grafana/isolation.py to create the LBAC data sources)
# ---------------------------------------------------------------------------
GC_METRICS_QUERY_URL="https://<prometheus-host>.grafana.net/api/prom"
GC_LOGS_QUERY_URL="https://<logs-host>.grafana.net"
# Cloud Access Policy token, scopes: metrics:read, logs:read, and NO label selectors
# (access-policy label selectors override data source LBAC rules)
GC_READ_TOKEN=

# ---------------------------------------------------------------------------
# Grafana API (used by grafana/isolation.py)
# ---------------------------------------------------------------------------
GRAFANA_URL="https://<your-stack>.grafana.net"
# Short-lived service account token. See README "Setup credentials" for the
# permissions it needs. Delete the service account after setup.
GRAFANA_TOKEN=

# ---------------------------------------------------------------------------
# Local runtime (optional)
# ---------------------------------------------------------------------------
DEMO_METRICS_PORT=9477
DEMO_ALLOY_LISTEN=127.0.0.1:12399
DEMO_MAX_HOURS=168
DEMO_INCIDENT_CYCLE_MINUTES=20
DEMO_INCIDENT_MINUTES=6
